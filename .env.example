# Stable edge identity. These are serialized references, not backend credentials.
HOME_CORTEX_CLIENT_DEVICE_ID=device:dev_macbook
HOME_CORTEX_CLIENT_CAMERA_ID=camera:built_in
HOME_CORTEX_CLIENT_EMBODIMENT_ID=embodiment:macbook-0

# Set both to register an existing embodiment with Home Cortex.
# HOME_CORTEX_CLIENT_CORTEX_URL=http://127.0.0.1:8001
# HOME_CORTEX_CLIENT_CORTEX_API_KEY=<local API key>

# Local capture and preview settings.
HOME_CORTEX_CLIENT_SOURCE=mac
HOME_CORTEX_CLIENT_CAMERA_INDEX=0
HOME_CORTEX_CLIENT_STREAM_HOST=127.0.0.1
HOME_CORTEX_CLIENT_STREAM_PORT=8088
HOME_CORTEX_CLIENT_FPS=10
# HOME_CORTEX_CLIENT_WIDTH=1280
# HOME_CORTEX_CLIENT_HEIGHT=720
