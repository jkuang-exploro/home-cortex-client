# Stable edge identity. These are serialized references, not backend credentials.
HOME_CORTEX_CLIENT_DEVICE_ID=device:dev_macbook
HOME_CORTEX_CLIENT_CAMERA_ID=camera:built_in
HOME_CORTEX_CLIENT_EMBODIMENT_ID=embodiment:macbook-0

# V1 is the default. Enroll first; HTTPS origin is stored in identity.json.
HOME_CORTEX_CLIENT_INTERFACE=v1
# HOME_CORTEX_CLIENT_CORTEX_URL=https://home-cortex-0:8443
# HOME_CORTEX_CLIENT_CREDENTIALS_DIR=/secure/path/credentials
# HOME_CORTEX_CLIENT_STATE_DIR=/secure/path/protocol
# Default credentials: ~/Library/Application Support/Home Cortex Client/credentials
# Credentials/protocol state must be owner-only (0700 directories, 0600 files).
# Explicit temporary rollback only: INTERFACE=legacy plus HTTP URL and API key.
# Never supply a bearer key for V1; authentication failure does not fall back.

# Local capture and preview settings.
HOME_CORTEX_CLIENT_SOURCE=mac
HOME_CORTEX_CLIENT_CAMERA_INDEX=0
HOME_CORTEX_CLIENT_STREAM_HOST=127.0.0.1
HOME_CORTEX_CLIENT_STREAM_PORT=8088
HOME_CORTEX_CLIENT_FPS=10
# HOME_CORTEX_CLIENT_WIDTH=1280
# HOME_CORTEX_CLIENT_HEIGHT=720
# HOME_CORTEX_CLIENT_BUFFER_SECONDS=60
# HOME_CORTEX_CLIENT_FRESHNESS_SECONDS=2
# HOME_CORTEX_CLIENT_EVIDENCE_DIR=
# HOME_CORTEX_CLIENT_EVIDENCE_MAX_ITEMS=8

# Local visual-change candidates. These clips stay on this machine.
# HOME_CORTEX_CLIENT_DETECTOR_HZ=4
# HOME_CORTEX_CLIENT_MOTION_START_THRESHOLD=0.08
# HOME_CORTEX_CLIENT_MOTION_CONTINUE_THRESHOLD=0.04
# HOME_CORTEX_CLIENT_SCENE_CHANGE_THRESHOLD=0.45
# HOME_CORTEX_CLIENT_SETTLING_SECONDS=1
# HOME_CORTEX_CLIENT_MINIMUM_EVENT_DURATION=0.4
# HOME_CORTEX_CLIENT_PRE_ROLL_SECONDS=3
# HOME_CORTEX_CLIENT_POST_ROLL_SECONDS=5
# HOME_CORTEX_CLIENT_MERGE_GAP_SECONDS=2
# HOME_CORTEX_CLIENT_MINIMUM_PEAK_SCORE=0.08
# HOME_CORTEX_CLIENT_MAXIMUM_CANDIDATE_DURATION=30
# HOME_CORTEX_CLIENT_COOLDOWN_SECONDS=0
# HOME_CORTEX_CLIENT_MAX_CANDIDATES=32
# HOME_CORTEX_CLIENT_MAX_CANDIDATE_AGE_SECONDS=21600
# HOME_CORTEX_CLIENT_MAX_CANDIDATE_DISK_BYTES=268435456
# HOME_CORTEX_CLIENT_SCENE_CHANGE_CANDIDATES=true

# Local semantic filter for candidate clips. off leaves Stage 2 unchanged.
# vision uses Apple's Vision framework; hog uses OpenCV's default people detector.
# Results stay on this machine. No analyzer is selected by default.
# HOME_CORTEX_CLIENT_ANALYZER=off

# Reference promotion policy. Used only while an analyzer is selected.
# Confidence is an uncalibrated local gate. retain keeps a repeat on disk;
# drop records DROP and still does not delete the clip.
# HOME_CORTEX_CLIENT_PROMOTION_WINDOW_SECONDS=8
# HOME_CORTEX_CLIENT_PROMOTION_MIN_CONFIDENCE=0.5
# HOME_CORTEX_CLIENT_PROMOTION_REPEAT=retain
# HOME_CORTEX_CLIENT_PROMOTION_OVERRIDE=

# Session advertisement. List only names already configured on the embodiment.
# The default is vision.observe. vision.autonomous_promotion is what allows
# PROMOTE uploads. vision.semantic_filter stays local and is not a session name.
# HOME_CORTEX_CLIENT_CAPABILITIES=vision.observe
# HOME_CORTEX_CLIENT_PROMOTION_QUEUE_LIMIT=8
# HOME_CORTEX_CLIENT_PROMOTION_MAX_AGE_SECONDS=21600
